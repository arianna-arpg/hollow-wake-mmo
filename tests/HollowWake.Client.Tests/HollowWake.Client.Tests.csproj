<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Tests for the interface's layout logic. The Godot client keeps that logic in plain classes under
    src/HollowWake.Client/UI/Logic that never touch an engine type, so they compile here on their own; the
    content tests read the shipped content/core with the core loader.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>HollowWake.Client.Tests</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\..\src\HollowWake.Client\UI\Logic\**\*.cs" Link="Logic\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\..\src\HollowWake.Client\World\Logic\**\*.cs" Link="WorldLogic\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\HollowWake.Core\HollowWake.Core.csproj" />
  </ItemGroup>
</Project>
