; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but input actions are registered from code (see InputSetup.cs) so this stays small.

config_version=5

[application]

config/name="Hollow Wake"
run/main_scene="res://scenes/Main.tscn"
config/features=PackedStringArray("4.7", "C#", "Forward Plus")
config/icon="res://icon.svg"
config/windows_native_icon="res://Branding/icon.ico"
boot_splash/image="res://Branding/icon.png"
boot_splash/bg_color=Color(0.02745, 0.02745, 0.05098, 1)
boot_splash/fullsize=false
boot_splash/use_filter=true

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/aspect="expand"

[dotnet]

project/assembly_name="HollowWake.Client"

[rendering]

anti_aliasing/quality/msaa_3d=1
