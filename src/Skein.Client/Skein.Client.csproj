<Project Sdk="Godot.NET.Sdk/4.7.2">
  <!-- Godot 4 client: presentation only. Simulation rules come from Skein.Core; wire format from Skein.Protocol. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <RootNamespace>Skein.Client</RootNamespace>
    <AssemblyName>Skein.Client</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Skein.Core\Skein.Core.csproj" />
    <ProjectReference Include="..\Skein.Protocol\Skein.Protocol.csproj" />
  </ItemGroup>
</Project>
