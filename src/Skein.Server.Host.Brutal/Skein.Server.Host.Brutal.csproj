<Project Sdk="Microsoft.NET.Sdk">
  <!--
    BRUTAL-backed host: RakNet UDP transport and the BRUTAL job runner.
    BRUTAL packages are .NET 10 only. When built with an older SDK this project
    compiles to a stub that explains the requirement, so building Skein.sln
    always succeeds; with the .NET 10 SDK it becomes the real host.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Skein.Server.Host.Brutal</RootNamespace>
    <AssemblyName>skein-server-brutal</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SkeinHasNet10 Condition="$([MSBuild]::VersionGreaterThanOrEquals('$(NETCoreSdkVersion)', '10.0'))">true</SkeinHasNet10>
    <TargetFramework Condition="'$(SkeinHasNet10)' == 'true'">net10.0</TargetFramework>
    <TargetFramework Condition="'$(SkeinHasNet10)' != 'true'">net8.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants Condition="'$(SkeinHasNet10)' == 'true'">$(DefineConstants);SKEIN_BRUTAL</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Skein.Server\Skein.Server.csproj" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="8.0.1" Condition="'$(SkeinHasNet10)' != 'true'" />
  </ItemGroup>
  <ItemGroup Condition="'$(SkeinHasNet10)' == 'true'">
    <PackageReference Include="Ahwoo.Brutal.Core" Version="2026.10.1" />
    <PackageReference Include="Ahwoo.Brutal.Interop" Version="2026.10.1" />
    <PackageReference Include="Ahwoo.Brutal.Strings" Version="2026.10.1" />
    <PackageReference Include="Ahwoo.Brutal.RakNet" Version="2026.10.2" />
    <PackageReference Include="Ahwoo.Brutal.Concurrency" Version="2026.10.1" />
    <PackageReference Include="Ahwoo.Brutal.Logging" Version="2026.10.2" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup Condition="'$(SkeinHasNet10)' != 'true'">
    <Compile Remove="**/*.cs" />
    <Compile Include="Stub/RequiresNet10.cs" />
  </ItemGroup>
  <ItemGroup Condition="'$(SkeinHasNet10)' == 'true'">
    <Compile Remove="Stub/**/*.cs" />
  </ItemGroup>
</Project>
