<Project Sdk="Microsoft.NET.Sdk">
  <!-- Pure .NET host: TCP transport, thread-pool scheduler. Runs anywhere .NET 8 runs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>HollowWake.Server.Host</RootNamespace>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AssemblyName>hollowwake-server</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\HollowWake.Server\HollowWake.Server.csproj" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
  </ItemGroup>
</Project>
