{
  "schema": "hollow-wake.forecast.proposal.v1",
  "description": "Design fixture only. Not a registered content kind or production wire message.",
  "provider": {"effectType": "area", "regionSource": "shared-resolved-delivery-plan"},
  "mechanics": {
    "direction": {"mode": "locked_on_start"},
    "anchor": {"mode": "source_at_release"},
    "dimensions": {"mode": "live_until_release"},
    "targetTest": "center",
    "occlusion": "delivery_line_of_sight",
    "height": {"mode": "legacy_anchor_tolerance", "halfHeight": 4},
    "movement": "resolved_cast_move_factor",
    "interrupt": "existing_runtime_rules"
  },
  "meta": {"forecast": {
    "profile": "area_warning",
    "trackingBoundary": "dashed",
    "committedDirectionMarker": "closed_chevron",
    "conditionalBoundary": "broken_inner_stroke",
    "hostilePattern": "outward_teeth",
    "friendlyPattern": "inward_ticks",
    "neutralPattern": "dotted",
    "unknownPattern": "crosshatch",
    "reducedMotion": {"sweep": false, "pulse": false, "cameraShake": false, "progress": "linear_meter"},
    "preserve": ["boundary", "direction", "relation", "timing", "uncertainty", "surface"]
  }},
  "exampleTrackingVariant": {
    "description": "Optional reusable mechanic only if an explicit mutator requires it; not a skill-specific casting method or current runtime behavior.",
    "direction": {"mode": "track_until_commit", "turnRateDegreesPerSecond": 180, "commitBeforeReleaseSeconds": 0.3},
    "commitAcknowledgmentRequired": true
  },
  "network": {
    "feature": "cast_forecast_v1",
    "clock": "server_simulation_seconds",
    "expiryGraceSeconds": 0.25,
    "expiryMeaning": "unknown_end",
    "terminalRetentionSeconds": 4,
    "identity": ["zoneEpoch", "castId"],
    "baseline": "complete_active_forecast_set_at_revision"
  },
  "threadDisplay": {"ember": {"name": "Flame", "element": "Fire"}}
}
