{
  "kind": "behaviors",
  "entries": [
    {
      "id": "golem_guard",
      "initial": "watch",
      "tick_interval": 0.3,
      "aggro_range": 10,
      "leash_range": 20,
      "states": {
        "watch": {
          "tick": [
            {
              "type": "acquire_target",
              "filter": "enemy"
            }
          ],
          "transitions": [
            {
              "to": "press",
              "when": "has_target",
              "priority": 10
            }
          ]
        },
        "press": {
          "tick": [
            {
              "type": "chase",
              "stop": 1.2
            },
            {
              "type": "attack"
            }
          ],
          "transitions": [
            {
              "to": "return",
              "when": "!has_target || home_distance > leash_range",
              "priority": 10
            }
          ]
        },
        "return": {
          "enter": [
            {
              "type": "drop_target"
            }
          ],
          "tick": [
            {
              "type": "return_home"
            }
          ],
          "transitions": [
            {
              "to": "watch",
              "when": "home_distance < 1",
              "priority": 10
            }
          ]
        }
      }
    }
  ]
}
