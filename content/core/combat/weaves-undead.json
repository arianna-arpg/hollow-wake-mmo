    {
      "id": "bone_arrow",
      "name": "Bone Arrow",
      "form": "shot",
      "threads": [
        "stone"
      ],
      "tags": [
        "bone"
      ],
      "description": "A straight physical arrow from the skeletal archer's bow.",
      "attributes": {
        "cast.time": 0.85,
        "cost.base.stamina": 0,
        "damage.effectiveness": 1,
        "range": 12,
        "projectile.speed": 18
      },
      "ai": {
        "role": "damage",
        "preferred_range": 9,
        "weight": 1
      },
      "effects": [
        {
          "type": "projectile",
          "radius": 0.16,
          "on_hit": [
            {
              "type": "damage",
              "threads": "$threads",
              "amount": "lerp(weapon.damage.min, weapon.damage.max, roll) * weave.damage.effectiveness * attack.power"
            }
          ]
        }
      ],
      "meta": {
        "prototype": {
          "id": "bone_arrow"
        },
        "integration": "Basic weapon-driven shot on the existing shell."
      }
    },
