{
  "_doc": "Hollow Wake MMO web client settings, read at build time and again from config.json beside the page at startup, so a deployed client can be retuned by editing dist/config.json. Fields are described in docs/design/web-client.md.",
  "server": {
    "host": "",
    "port": 0,
    "secure": null,
    "path": "/ws",
    "account": "marcher",
    "probeSameOrigin": true,
    "features": ["entity_delta"]
  },
  "world": {
    "chunkRadius": 3,
    "maxChunkRequestsInFlight": 6,
    "chunkRequestTimeoutSeconds": 10,
    "chunkRetrySeconds": 5,
    "meshBuildsPerFrame": 2,
    "pingSeconds": 5
  },
  "camera": {
    "mode": "isometric",
    "isoYawDegrees": 45,
    "isoPitchDegrees": 35.264,
    "isoSize": 28,
    "isoSizeMin": 8,
    "isoSizeMax": 90,
    "isoZoomStep": 3,
    "isoDistance": 120,
    "isoRotateStepDegrees": 45,
    "isoFollowRate": 10,
    "thirdFovDegrees": 65,
    "thirdDistance": 14,
    "thirdDistanceMin": 3,
    "thirdDistanceMax": 60,
    "thirdZoomStep": 1.5,
    "thirdPitchDegrees": 28,
    "thirdPitchMinDegrees": 5,
    "thirdPitchMaxDegrees": 80,
    "thirdRotateStepDegrees": 15,
    "thirdEyeHeight": 1.6,
    "thirdFollowRate": 14,
    "orbitSensitivity": 0.005,
    "pitchSensitivity": 0.004,
    "wheelStepPixels": 100,
    "near": 0.2,
    "far": 600
  },
  "motion": {
    "interpolationDelayMs": 150,
    "maxExtrapolationMs": 250,
    "selfSmoothing": 12
  },
  "input": {
    "bindings": {
      "move_forward": ["KeyW"],
      "move_back": ["KeyS"],
      "move_left": ["KeyA"],
      "move_right": ["KeyD"],
      "jump": ["Space"],
      "interact": ["KeyF"],
      "pick_up": ["KeyG"],
      "respawn": ["KeyR"],
      "camera_toggle": ["KeyV"],
      "camera_rotate_left": ["KeyQ"],
      "camera_rotate_right": ["KeyE"],
      "toggle_sheet": ["KeyC"],
      "chat": ["Enter", "NumpadEnter"],
      "cancel": ["Escape"],
      "slot_1": ["Digit1", "Numpad1"],
      "slot_2": ["Digit2", "Numpad2"],
      "slot_3": ["Digit3", "Numpad3"],
      "slot_4": ["Digit4", "Numpad4"],
      "slot_5": ["Digit5", "Numpad5"],
      "slot_6": ["Digit6", "Numpad6"],
      "slot_7": ["Digit7", "Numpad7"],
      "slot_8": ["Digit8", "Numpad8"]
    },
    "interactReach": 6
  },
  "render": {
    "maxPixelRatio": 2,
    "antialias": true,
    "shadows": false,
    "background": "#8ca8cc",
    "fogColor": "#9eb3d1",
    "fogDensity": 0.0007,
    "sunColor": "#fff6e8",
    "sunIntensity": 2.6,
    "sunPitchDegrees": -55,
    "sunYawDegrees": 35,
    "ambientSky": "#c4cde0",
    "ambientGround": "#6b6655",
    "ambientIntensity": 1.6
  },
  "terrain": {
    "base": [
      { "tags": ["snow"], "color": "#e8ecf0" },
      { "tags": ["ash"], "color": "#6b4a3a" },
      { "tags": ["grey"], "color": "#4a4452" },
      { "tags": ["bog"], "color": "#4f6b3a" },
      { "tags": ["sand"], "color": "#d8c89a" },
      { "tags": ["rock"], "color": "#8c8a7a" },
      { "tags": ["forest_floor", "deep"], "color": "#1f4d22" },
      { "tags": ["forest_floor"], "color": "#2f6b2f" },
      { "tags": ["scrub"], "color": "#b8a35a" },
      { "tags": ["heath"], "color": "#9aa05a" },
      { "tags": ["meadow"], "color": "#79b84a" },
      { "tags": ["grass"], "color": "#5b8c3a" }
    ],
    "fallback": "#738c59",
    "structure": [
      { "tags": ["road"], "color": "#9e8f75" },
      { "tags": ["wall"], "color": "#807a80" },
      { "tags": ["house"], "color": "#807a80" },
      { "tags": ["pillar"], "color": "#807a80" }
    ],
    "structureFallback": "#99948a",
    "tints": [
      { "flags": ["road"], "color": "#9e8f75", "mix": 0.7 },
      { "tags": ["cliff"], "darken": 0.35 },
      { "tags": ["shallow"], "flags": ["water"], "color": "#5b8fa3", "mix": 0.45 },
      { "tags": ["deep"], "flags": ["water"], "color": "#2f5878", "mix": 0.65 },
      { "flags": ["blocked"], "darken": 0.2 }
    ],
    "skirtDarken": 0.3,
    "layers": [
      { "tags": ["bridge"], "color": "#8c6b4d" }
    ],
    "layerFallback": "#99948c",
    "waterColor": "#3373b3",
    "waterOpacity": 0.55
  },
  "entities": {
    "player": "#59bff2",
    "drops": { "normal": "#d9d9cc", "magic": "#6699ff", "rare": "#ffd44d", "unique": "#e66633" },
    "projectile": "#ff9933",
    "field": "#804db3",
    "fieldOpacity": 0.35,
    "poi": "#f2e680",
    "fount": "#99e6ff",
    "flora": [
      { "match": ["oak", "pine", "birch", "tree"], "color": "#337333", "tree": true },
      { "match": ["boulder", "stone", "vein"], "color": "#808080", "tree": false },
      { "match": ["anvil", "loom"], "color": "#996640", "tree": false }
    ],
    "floraFallback": "#598c4d",
    "trunk": "#6b4d33",
    "factions": {
      "players": "#66cc99",
      "weftmarch_compact": "#bfbf73",
      "lantern_chancery": "#bfbf73",
      "mended_thread": "#bfbf73",
      "the_loosed": "#cc4d4d",
      "tangled": "#593373",
      "remnant": "#736699"
    },
    "rarities": { "magic": "#8099ff", "rare": "#ffcc4d", "champion": "#ff8c40" },
    "creatureFallback": "#b38059",
    "labelColors": { "player": "#b3e6ff", "dead": "#999999", "magic": "#8099ff", "rare": "#ffd966", "champion": "#ff994d" },
    "labelDefault": "#ffffff",
    "deadOpacity": 0.4
  },
  "ui": {
    "noticeSeconds": 4,
    "chatLines": 200,
    "resourceColors": { "life": "#bf3333", "mana": "#3373d9", "stamina": "#40a64d", "ward": "#e6bf33" },
    "resourceFallback": "#808080",
    "rarityColors": { "magic": "#6c9cff", "rare": "#ffd34d", "unique": "#e8622a" },
    "rarityFallback": "#d0d0d0",
    "hint": "WASD or click to move, Space jumps, 1-8 weaves, F interact, G pick up, V camera, Q/E rotate, C sheet, Enter chat"
  }
}
