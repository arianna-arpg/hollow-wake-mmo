{
  "_doc": "Hollow Wake MMO web client settings, read at build time and again from config.json beside the page at startup, so a deployed client can be retuned by editing dist/config.json. Fields are described in docs/design/web-client.md. The look of the world and its bodies is content under content/core/appearance, not configuration.",
  "server": {
    "host": "",
    "port": 0,
    "secure": null,
    "path": "/ws",
    "account": "marcher",
    "probeSameOrigin": true,
    "features": [
      "entity_delta"
    ]
  },
  "world": {
    "chunkRadius": 3,
    "maxChunkRequestsInFlight": 6,
    "chunkRequestTimeoutSeconds": 10,
    "chunkRetrySeconds": 5,
    "meshBuildsPerFrame": 2,
    "pingSeconds": 5
  },
  "camera": {
    "mode": "isometric",
    "isoYawDegrees": 45,
    "isoPitchDegrees": 35.264,
    "isoSize": 28,
    "isoSizeMin": 8,
    "isoSizeMax": 90,
    "isoZoomStep": 3,
    "isoDistance": 120,
    "isoRotateStepDegrees": 45,
    "isoFollowRate": 10,
    "thirdFovDegrees": 65,
    "thirdDistance": 14,
    "thirdDistanceMin": 3,
    "thirdDistanceMax": 60,
    "thirdZoomStep": 1.5,
    "thirdPitchDegrees": 28,
    "thirdPitchMinDegrees": 5,
    "thirdPitchMaxDegrees": 80,
    "thirdRotateStepDegrees": 15,
    "thirdEyeHeight": 1.6,
    "thirdFollowRate": 14,
    "orbitSensitivity": 0.005,
    "pitchSensitivity": 0.004,
    "wheelStepPixels": 100,
    "near": 0.2,
    "far": 600
  },
  "motion": {
    "interpolationDelayMs": 150,
    "maxExtrapolationMs": 250,
    "selfSmoothing": 12
  },
  "input": {
    "interactReach": 6
  },
  "render": {
    "maxPixelRatio": 2,
    "antialias": true,
    "shadows": false,
    "background": "#8ca8cc",
    "fogColor": "#9eb3d1",
    "fogDensity": 0.0007,
    "sunColor": "#fff6e8",
    "sunIntensity": 2.6,
    "sunPitchDegrees": -55,
    "sunYawDegrees": 35,
    "ambientSky": "#c4cde0",
    "ambientGround": "#6b6655",
    "ambientIntensity": 1.6
  },
  "entities": {
    "player": "#59bff2",
    "projectile": "#ff9933",
    "field": "#804db3",
    "fieldOpacity": 0.35,
    "telegraph": "#ff5a36",
    "telegraphOpacity": 0.5,
    "factions": {
      "players": "#66cc99",
      "weftmarch_compact": "#bfbf73",
      "lantern_chancery": "#bfbf73",
      "mended_thread": "#bfbf73",
      "the_loosed": "#cc4d4d",
      "tangled": "#593373",
      "remnant": "#736699"
    },
    "labelColors": {
      "player": "#b3e6ff",
      "dead": "#999999",
      "magic": "#8099ff",
      "rare": "#ffd966",
      "champion": "#ff994d"
    },
    "labelDefault": "#ffffff",
    "deadOpacity": 0.4
  }
}
